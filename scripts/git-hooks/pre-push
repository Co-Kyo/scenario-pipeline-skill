#!/bin/sh
# dev 分支 push 前强制门：build & test 本地全绿才放行。
# 落点：sp-skill-dev 仓 dev 分支（开发分支）；release 分支由 Action 打包更新，不手动推。
# 触发：git push 时若推送包含 dev 分支，即在本地跑 typecheck + test + verify:product + build，
# 任一失败则拒绝 push。main/release/chore 等分支不受影响。
# 维护：测试入口见 package.json（test / verify:product / build / typecheck）。

should_check=0
while read local_ref local_oid remote_ref remote_oid; do
  case "$local_ref" in
    refs/heads/dev) should_check=1 ;;
  esac
done

if [ "$should_check" = "0" ]; then
  exit 0
fi

echo "[pre-push] dev 分支强制门：typecheck + test + verify:product + build …"
npm run typecheck || { echo "[pre-push] ❌ typecheck 红，拒绝 push dev"; exit 1; }
npm test || { echo "[pre-push] ❌ test 红，拒绝 push dev"; exit 1; }
npm run verify:product || { echo "[pre-push] ❌ verify:product 红，拒绝 push dev"; exit 1; }
npm run build || { echo "[pre-push] ❌ build 红，拒绝 push dev"; exit 1; }
echo "[pre-push] ✅ 全绿，放行 push dev"
